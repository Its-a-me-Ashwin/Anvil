# .code-workspace files — see _project_sandbox_dir/_write_project_workspace_file
# in server.py. The */ rule also matches cad_output/animation_output
# themselves, which is fine — the two rules above already ignore those.
backend/sandbox_project/*/
backend/sandbox_project/*.code-workspace

