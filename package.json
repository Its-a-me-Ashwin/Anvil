{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env PATH=\"./tools/node20:$PATH\" vite",
    "build": "cross-env-shell PATH=\"./tools/node20:$PATH\" \"tsc && vite build\"",
    "preview": "cross-env-shell PATH=\"./tools/node20:$PATH\" \"vite preview\"",
    "code-server": "cross-env-shell PATH=\"./tools/node20:$PATH\" \"code serve-web --accept-server-license-terms --port 8080 --default-folder . --without-connection-token\"",
    "bridge": "cross-env PATH=\"./tools/node20:$PATH\" node server/workshopBridge.mjs",
    "dev:workshop": "cross-env PATH=\"./tools/node20:$PATH\" concurrently -n bridge,vite -c blue,green \"npm run bridge\" \"npm run dev\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.33.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "zustand": "^5.0.15"
  }
}
