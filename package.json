{
  "name": "anvil-tooling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "code-server": "cross-env-shell PATH=\"./tools/node20:$PATH\" \"code serve-web --accept-server-license-terms --port 8080 --default-folder . --without-connection-token\"",
    "bridge": "cross-env PATH=\"./tools/node20:$PATH\" node server/workshopBridge.mjs",
    "dev:workshop": "cross-env PATH=\"./tools/node20:$PATH\" concurrently -n bridge,vite -c blue,green \"npm run bridge\" \"npm --prefix frontend run dev\""
  },
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.7.10"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0"
  }
}
