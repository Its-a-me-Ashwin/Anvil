# Directory the filesystem adapter is allowed to read/write.
# Defaults to the Anvil project root (the parent of this backend/ directory) if unset.
ANVIL_PROJECT_DIR=..

# Gemini API key for the ADK agent, for generate_animation's Veo calls, and
# for generate_soundtrack/score_animation's Lyria RealTime calls (same key,
# same Gemini Developer API — no separate Veo or Lyria key needed).
# Get one at https://aistudio.google.com/app/apikey. Veo requires the
# associated Google Cloud project to have billing enabled (not available on
# the free tier); without that, generate_animation and the music tools fall
# back to a free local mock clip/tone instead of failing.
GEMINI_API_KEY=your_key_here

# URL of the Anvil Workshop Bridge for the printer adapter.
# Defaults to http://localhost:3001 if unset.
ANVIL_BRIDGE_URL=http://localhost:3001

# Google Cloud project used by the state adapter's Firestore client.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Firestore database ID for the state adapter. Leave as (default) for the
# default database.
FIRESTORE_DATABASE=(default)

# Firestore emulator host for local testing. Leave empty to use real Firestore.
# Example: FIRESTORE_EMULATOR_HOST=localhost:8200
FIRESTORE_EMULATOR_HOST=

# Local Ollama server URL and model used to monitor the printer camera
# (isBedEmpty/isSpaghetti/isPrinting). Run `ollama pull gemma3:4b` first.
OLLAMA_URL=http://localhost:11434
VISION_MODEL=gemma3:4b

# Veo model for generate_animation. Defaults to the lite tier (cheapest) if
# unset. Other options: veo-3.1-fast-generate-preview, veo-3.1-generate-preview.
VEO_MODEL=veo-3.1-lite-generate-preview

# Lyria 3 model for generate_soundtrack/score_animation. Defaults to the
# clip tier (cheaper) if unset. Other option: models/lyria-3-pro-preview.
LYRIA_MODEL=models/lyria-3-clip-preview

# YouTube Data API v3 key for find_tutorial_video — a separate key from
# GEMINI_API_KEY, since this is a distinct Google Cloud API. Enable "YouTube
# Data API v3" for your project at https://console.cloud.google.com/apis/library,
# then create a key at https://console.cloud.google.com/apis/credentials.
# Free within the default daily quota (a search costs 100 of 10,000 units/day).
YOUTUBE_API_KEY=
