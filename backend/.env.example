# Directory the filesystem adapter is allowed to read/write.
# Defaults to the Anvil project root (the parent of this backend/ directory) if unset.
ANVIL_PROJECT_DIR=..

# Gemini API key for the ADK agent, and for generate_animation's Veo calls
# (same key, same Gemini Developer API — no separate Veo key needed).
# Get one at https://aistudio.google.com/app/apikey. Veo requires the
# associated Google Cloud project to have billing enabled (not available on
# the free tier); without that, generate_animation falls back to a free
# local mock clip instead of failing.
GEMINI_API_KEY=your_key_here

# URL of the Anvil Workshop Bridge for the printer adapter.
# Defaults to http://localhost:3001 if unset.
ANVIL_BRIDGE_URL=http://localhost:3001

# Google Cloud project used by the state adapter's Firestore client.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Firestore database ID for the state adapter. Leave as (default) for the
# default database.
FIRESTORE_DATABASE=(default)

# Firestore emulator host for local testing. Leave empty to use real Firestore.
# Example: FIRESTORE_EMULATOR_HOST=localhost:8200
FIRESTORE_EMULATOR_HOST=

# Path to an MP4 file used as the local camera stream placeholder.
VISION_VIDEO_PATH=

# Local Ollama server URL and model used by the vision worker.
OLLAMA_URL=http://localhost:11434
VISION_MODEL=gemma3:4b

# Veo model for generate_animation. Defaults to the lite tier (cheapest) if
# unset. Other options: veo-3.1-fast-generate-preview, veo-3.1-generate-preview.
VEO_MODEL=veo-3.1-lite-generate-preview
