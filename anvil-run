#!/usr/bin/env bash
# Anvil local orchestration script.
# Usage:
#   ./anvil-run --status
#   ./anvil-run --start [service]
#   ./anvil-run --stop [service]
#
# Services: firestore, bridge, backend, code-server, frontend

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
RUNDIR="$ROOT/.anvil-workshop"
LOGDIR="$RUNDIR/logs"
PIDDIR="$RUNDIR/pids"

mkdir -p "$LOGDIR" "$PIDDIR"

case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
  *) IS_WINDOWS=0 ;;
esac

if [ "$IS_WINDOWS" = "1" ]; then
  BACKEND_PY="$ROOT/backend/.venv/Scripts/python.exe"
  ROOT_VENV_PY="$ROOT/.venv/Scripts/python.exe"
else
  BACKEND_PY="$ROOT/backend/.venv/bin/python"
  ROOT_VENV_PY="$ROOT/.venv/bin/python"
fi

# The backend needs Python 3.10+. Prefer a versioned interpreter over a bare
# "python3", since on macOS that often resolves to the old Xcode Command Line
# Tools Python (3.9) ahead of Homebrew's in PATH.
pick_backend_python() {
  local candidate
  for candidate in python3.12 python3.11 python3.13 python3.10; do
    if command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return 0
    fi
  done
  return 1
}

port_pid() {
  local port="$1"
  if [ "$IS_WINDOWS" = "1" ]; then
    netstat -ano 2>/dev/null | grep -E ":$port\s+" | grep LISTENING | awk '{print $5}' | head -n1
  else
    lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -n1
  fi
}

kill_pid() {
  local pid="$1"
  if [ "$IS_WINDOWS" = "1" ]; then
    cmd //c "taskkill /F /T /PID $pid" >/dev/null 2>&1 || true
  else
    kill "$pid" >/dev/null 2>&1 || true
    sleep 0.3
    kill -9 "$pid" >/dev/null 2>&1 || true
  fi
}

ensure_npm_deps() {
  if [ ! -d "$ROOT/node_modules" ]; then
    echo "  node_modules not found -- running npm install..."
    (cd "$ROOT" && npm install) || return 1
  fi
}

wait_for_port() {
  local svc="$1" port="$2"
  local tries=20
  # Backend spins up an MCP filesystem subprocess and loads the agent before
  # binding its port, which takes noticeably longer than the other services.
  if [ "$svc" = "backend" ]; then
    tries=60
  fi
  local i pid
  for i in $(seq 1 "$tries"); do
    pid="$(port_pid "$port" || true)"
    if [ -n "$pid" ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

service_port() {
  case "$1" in
    firestore) echo 8200 ;;
    bridge) echo 3001 ;;
    backend) echo 8000 ;;
    code-server) echo 8080 ;;
    frontend) echo 5173 ;;
    *) echo "" ;;
  esac
}

service_label() {
  case "$1" in
    firestore) echo "Firestore emulator" ;;
    bridge) echo "Workshop bridge" ;;
    backend) echo "Backend API" ;;
    code-server) echo "Code server" ;;
    frontend) echo "Frontend" ;;
    *) echo "$1" ;;
  esac
}

status_service() {
  local svc="$1"
  if [ "$svc" = "firestore" ]; then
    local cid
    cid="$(docker ps -q -f name=firestore-emulator 2>/dev/null || true)"
    if [ -n "$cid" ]; then
      printf "running (docker %s)\n" "$cid"
    else
      printf "not running\n"
    fi
    return
  fi

  local port pid
  port="$(service_port "$svc")"
  pid="$(port_pid "$port" || true)"
  if [ -n "$pid" ]; then
    printf "running (pid %s)\n" "$pid"
  else
    printf "not running\n"
  fi
}

cmd_status() {
  printf "%-20s %s\n" "Service" "Status"
  printf "%-20s %s\n" "-------" "------"
  for svc in firestore bridge backend code-server frontend; do
    printf "%-20s %s\n" "$(service_label "$svc")" "$(status_service "$svc")"
  done
}

stop_service() {
  local svc="$1"
  echo "Stopping $(service_label "$svc")..."

  if [ "$svc" = "firestore" ]; then
    docker stop firestore-emulator >/dev/null 2>&1 || true
    docker rm firestore-emulator >/dev/null 2>&1 || true
    return
  fi

  local pidfile="$PIDDIR/$svc.pid"
  if [ -f "$pidfile" ]; then
    local pid
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [ -n "$pid" ]; then
      kill_pid "$pid"
    fi
    rm -f "$pidfile"
  fi

  # Fallback: kill anything still listening on the port.
  local port
  port="$(service_port "$svc")"
  pid="$(port_pid "$port" || true)"
  if [ -n "$pid" ]; then
    kill_pid "$pid"
  fi
}

start_service() {
  local svc="$1"
  local port
  port="$(service_port "$svc")"

  # Restart if already running.
  if [ "$svc" != "firestore" ]; then
    local current_pid
    current_pid="$(port_pid "$port" || true)"
    if [ -n "$current_pid" ]; then
      stop_service "$svc"
      sleep 1
    fi
  else
    local cid
    cid="$(docker ps -q -f name=firestore-emulator 2>/dev/null || true)"
    if [ -n "$cid" ]; then
      stop_service "$svc"
      sleep 2
    fi
  fi

  echo "Starting $(service_label "$svc")..."

  case "$svc" in
    firestore)
      docker run -d \
        --name firestore-emulator \
        --rm \
        -p 8200:8080 \
        -e FIRESTORE_PROJECT_ID=anvil-local \
        mtlynch/firestore-emulator-docker \
        >"$LOGDIR/firestore.log" 2>&1
      ;;
    bridge)
      ensure_npm_deps || { echo "  -> npm install failed (see output above)"; return; }
      if [ ! -x "$ROOT_VENV_PY" ]; then
        echo "  root Python venv not found (needed for bambu-cli printer discovery/print) -- creating..."
        local setup_python
        setup_python="$(pick_backend_python || command -v python3 || true)"
        if [ -n "$setup_python" ]; then
          ("$setup_python" -m venv "$ROOT/.venv" \
            && "$ROOT_VENV_PY" -m pip install -q --upgrade pip \
            && "$ROOT_VENV_PY" -m pip install -q -r "$ROOT/requirements.txt") || \
            echo "  -> root venv setup failed (see output above); printer discovery/print will be unavailable until fixed"
        else
          echo "  -> no python3 interpreter found; printer discovery/print will be unavailable until 'python3 -m venv .venv && .venv/bin/pip install -r requirements.txt' is run manually"
        fi
      fi
      cd "$ROOT"
      nohup npm run bridge >"$LOGDIR/bridge.log" 2>&1 &
      echo $! >"$PIDDIR/bridge.pid"
      ;;
    backend)
      if [ ! -x "$BACKEND_PY" ]; then
        echo "  backend virtualenv not found -- running 'make setup'..."
        local setup_python
        setup_python="$(pick_backend_python || true)"
        if [ -n "$setup_python" ]; then
          (cd "$ROOT/backend" && make setup PYTHON="$setup_python") || {
            echo "  -> backend setup failed (see output above)"
            return
          }
        else
          (cd "$ROOT/backend" && make setup) || {
            echo "  -> backend setup failed -- install Python 3.10+ (e.g. 'brew install python@3.12') and retry"
            return
          }
        fi
      fi
      cd "$ROOT/backend"
      nohup "$BACKEND_PY" server.py >"$LOGDIR/backend.log" 2>&1 &
      echo $! >"$PIDDIR/backend.pid"
      ;;
    code-server)
      ensure_npm_deps || { echo "  -> npm install failed (see output above)"; return; }
      cd "$ROOT"
      nohup npm run code-server >"$LOGDIR/code-server.log" 2>&1 &
      echo $! >"$PIDDIR/code-server.pid"
      ;;
    frontend)
      ensure_npm_deps || { echo "  -> npm install failed (see output above)"; return; }
      cd "$ROOT"
      nohup npm run dev >"$LOGDIR/frontend.log" 2>&1 &
      echo $! >"$PIDDIR/frontend.pid"
      ;;
  esac

  if [ "$svc" = "firestore" ]; then
    sleep 2
  else
    if ! wait_for_port "$svc" "$port"; then
      echo "  -> failed to start (see .anvil-workshop/logs/$svc.log)"
      tail -n 20 "$LOGDIR/$svc.log" 2>/dev/null || true
      return
    fi
  fi
  local final_status
  final_status="$(status_service "$svc")"
  echo "  -> $final_status"
}

cmd_start() {
  local target="${1:-}"
  if [ -z "$target" ] || [ "$target" = "all" ]; then
    start_service firestore
    start_service bridge
    start_service backend
    start_service code-server
    start_service frontend
  else
    if [ -z "$(service_port "$target")" ]; then
      echo "Unknown service: $target"
      echo "Use: firestore, bridge, backend, code-server, frontend"
      exit 1
    fi
    start_service "$target"
  fi
}

cmd_stop() {
  local target="${1:-}"
  if [ -z "$target" ] || [ "$target" = "all" ]; then
    stop_service frontend
    stop_service code-server
    stop_service backend
    stop_service bridge
    stop_service firestore
  else
    if [ -z "$(service_port "$target")" ]; then
      echo "Unknown service: $target"
      echo "Use: firestore, bridge, backend, code-server, frontend"
      exit 1
    fi
    stop_service "$target"
  fi
}

usage() {
  cat <<EOF
Anvil local runner

Usage:
  ./anvil-run --status
  ./anvil-run --start [service|all]
  ./anvil-run --stop [service|all]

Services: firestore, bridge, backend, code-server, frontend
EOF
}

main() {
  case "${1:-}" in
    --status)
      cmd_status
      ;;
    --start)
      cmd_start "${2:-}"
      ;;
    --stop)
      cmd_stop "${2:-}"
      ;;
    --help|-h|*)
      usage
      ;;
  esac
}

main "$@"
